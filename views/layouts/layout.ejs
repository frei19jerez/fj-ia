<!DOCTYPE html>
<html lang="es">
<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title><%= typeof title !== 'undefined' ? title : 'FJ-IA' %></title>

  <meta name="description" content="FJ-IA - Inteligencia Artificial para crear texto, imágenes, voz, videos y películas.">

  <%
    const runtimePrefix =
      (typeof locals !== 'undefined' && locals.runtimePrefix)
        ? locals.runtimePrefix
        : '';
  %>

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    rel="stylesheet">

  <!-- Bootstrap Icons -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

  <!-- CSS principal -->
  <link
    rel="stylesheet"
    href="<%= runtimePrefix %>/styles/styles.css">

</head>

<body class="bg-light">

  <%- partial('../partials/navbar') %>

  <main class="container py-4">

    <% if (req.session && req.session.error) { %>

      <div class="alert alert-danger alert-dismissible fade show">

        <i class="bi bi-exclamation-triangle-fill"></i>

        <%= req.session.error %>

        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="alert">
        </button>

      </div>

      <% req.session.error = null; %>

    <% } %>

    <% if (req.session && req.session.success) { %>

      <div class="alert alert-success alert-dismissible fade show">

        <i class="bi bi-check-circle-fill"></i>

        <%= req.session.success %>

        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="alert">
        </button>

      </div>

      <% req.session.success = null; %>

    <% } %>

    <%- body %>

  </main>

  <%- partial('../partials/footer') %>

  <!-- Bootstrap -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

  <!-- JS principal -->
  <script src="<%= runtimePrefix %>/js/app.js"></script>

</body>
</html>