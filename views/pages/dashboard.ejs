<% if (
  req.session.error &&
  !String(req.session.error).toLowerCase().includes('creditos') &&
  !String(req.session.error).toLowerCase().includes('créditos')
) { %>

<div style="
  background:#7f1d1d;
  color:#fecaca;
  padding:18px;
  border-radius:16px;
  margin-bottom:25px;
  border:1px solid rgba(255,255,255,0.08);
">
  <%= req.session.error %>
</div>

<% } %>

<section class="page-head">

  <h1 style="
    font-size:56px;
    margin-bottom:10px;
    line-height:1.1;
  ">
    Hola, <%= usuario.nombre %> 👋
  </h1>

  <p style="
    color:#94a3b8;
    font-size:20px;
    margin-top:0;
  ">
    Créditos disponibles:
    <strong style="color:#4ade80;">
      ∞ Ilimitados
    </strong>
  </p>

  <div style="
    margin-top:25px;
    background:linear-gradient(135deg,#0f172a,#111827);
    border:1px solid rgba(255,255,255,0.08);
    padding:25px;
    border-radius:22px;
    box-shadow:0 10px 40px rgba(0,0,0,0.35);
  ">

    <h2 style="
      margin-top:0;
      margin-bottom:10px;
      font-size:28px;
    ">
      🧠 FJ-IA ACTIVADA
    </h2>

    <p style="
      color:#cbd5e1;
      line-height:1.8;
      margin-bottom:0;
      font-size:17px;
    ">
      Genera textos, imágenes, videos y películas con inteligencia artificial.
      Plataforma optimizada para creadores, negocios y redes sociales 🚀
    </p>

  </div>

</section>

<section class="grid">

  <a
    class="card tool"
    href="/crear-texto"
    style="
      text-decoration:none;
      transition:0.3s;
    "
  >

    <h2 style="
      font-size:34px;
      margin-bottom:10px;
    ">
      ✍️ Crear texto
    </h2>

    <p style="
      line-height:1.7;
      color:#cbd5e1;
    ">
      Anuncios, guiones, noticias y publicaciones inteligentes para redes sociales.
    </p>

    <div style="
      margin-top:20px;
      color:#38bdf8;
      font-weight:bold;
      font-size:15px;
    ">
      IA REAL →
    </div>

  </a>

  <a
    class="card tool"
    href="/crear-imagen"
    style="
      text-decoration:none;
      transition:0.3s;
    "
  >

    <h2 style="
      font-size:34px;
      margin-bottom:10px;
    ">
      🖼 Crear imagen
    </h2>

    <p style="
      line-height:1.7;
      color:#cbd5e1;
    ">
      Convierte ideas en imágenes profesionales listas para Facebook, Instagram y WhatsApp.
    </p>

    <div style="
      margin-top:20px;
      color:#38bdf8;
      font-weight:bold;
      font-size:15px;
    ">
      IA VISUAL →
    </div>

  </a>

  <a
    class="card tool"
    href="/crear-video"
    style="
      text-decoration:none;
      transition:0.3s;
    "
  >

    <h2 style="
      font-size:34px;
      margin-bottom:10px;
    ">
      🎬 Crear video
    </h2>

    <p style="
      line-height:1.7;
      color:#cbd5e1;
    ">
      Genera videos IA para TikTok, Reels, Shorts y campañas publicitarias.
    </p>

    <div style="
      margin-top:20px;
      color:#38bdf8;
      font-weight:bold;
      font-size:15px;
    ">
      VIDEO IA →
    </div>

  </a>

  <a
    class="card tool"
    href="/crear-pelicula"
    style="
      text-decoration:none;
      transition:0.3s;
    "
  >

    <h2 style="
      font-size:34px;
      margin-bottom:10px;
    ">
      🎥 Crear película
    </h2>

    <p style="
      line-height:1.7;
      color:#cbd5e1;
    ">
      Guiones, escenas, personajes y producción cinematográfica con IA.
    </p>

    <div style="
      margin-top:20px;
      color:#38bdf8;
      font-weight:bold;
      font-size:15px;
    ">
      CINE IA →
    </div>

  </a>

</section>

<section style="
  margin-top:60px;
">

  <div style="
    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
    gap:20px;
    margin-bottom:25px;
  ">

    <h2 style="
      font-size:42px;
      margin:0;
    ">
      📂 Últimos proyectos
    </h2>

    <a
      href="/mis-proyectos"
      style="
        text-decoration:none;
        color:#38bdf8;
        font-weight:bold;
        font-size:18px;
      "
    >
      Ver todos →
    </a>

  </div>

  <div class="list">

    <% if (proyectos.length === 0) { %>

      <div class="card row" style="
        text-align:center;
        padding:50px 20px;
      ">

        <h3 style="
          margin-top:0;
          font-size:30px;
        ">
          🚀 Aún no tienes proyectos
        </h3>

        <p style="
          color:#94a3b8;
          margin-bottom:0;
        ">
          Empieza creando contenido con inteligencia artificial.
        </p>

      </div>

    <% } %>

    <% proyectos.forEach(p => { %>

      <div class="card row" style="
        display:flex;
        justify-content:space-between;
        align-items:center;
        gap:20px;
        flex-wrap:wrap;
      ">

        <div>

          <strong style="
            display:block;
            font-size:22px;
            margin-bottom:8px;
          ">
            <%= p.titulo %>
          </strong>

          <span style="
            color:#94a3b8;
          ">
            <%= p.tipo %> — <%= p.estado %>
          </span>

        </div>

        <div style="
          display:flex;
          gap:12px;
          flex-wrap:wrap;
        ">

          <a
            href="/proyecto/<%= p.id %>"
            class="btn primary"
            style="text-decoration:none;"
          >
            👁 Ver
          </a>

          <form
            method="POST"
            action="/proyecto/<%= p.id %>/eliminar"
            onsubmit="return confirm('¿Eliminar proyecto?');"
          >

            <button
              class="btn"
              type="submit"
              style="
                background:#7f1d1d;
                color:#fff;
              "
            >
              🗑 Eliminar
            </button>

          </form>

        </div>

      </div>

    <% }) %>

  </div>

</section>