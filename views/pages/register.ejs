<%
  const prefix =
    typeof runtimePrefix !== 'undefined'
      ? runtimePrefix
      : '';
%>

<section class="card form-card">

  <h1>Crear cuenta</h1>

  <form
    method="POST"
    action="<%= prefix %>/register"
  >

    <label for="nombre">
      Nombre
    </label>

    <input
      id="nombre"
      name="nombre"
      type="text"
      autocomplete="name"
      required
    >

    <label for="email">
      Email
    </label>

    <input
      id="email"
      name="email"
      type="email"
      autocomplete="email"
      required
    >

    <label for="password">
      Contraseña
    </label>

    <input
      id="password"
      name="password"
      type="password"
      autocomplete="new-password"
      required
    >

    <button
      class="btn primary"
      type="submit"
    >
      Registrarme
    </button>

  </form>

</section>