<!DOCTYPE html>
<html lang="es">
<head>

  <!-- ==================================================
       🚀 FJ-IA
       Plataforma IA creada por Freimel Jerez
       Texto → Imagen → Video → Película
  =================================================== -->

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <%
    const prefix =
      typeof runtimePrefix !== 'undefined'
        ? runtimePrefix
        : '';
  %>

  <title>FJ-IA</title>

  <!-- SEO -->
  <meta
    name="description"
    content="FJ-IA convierte texto en imágenes, videos y películas con inteligencia artificial."
  >

  <meta
    name="keywords"
    content="IA, inteligencia artificial, texto a video, texto a imagen, AI, FJ-IA"
  >

  <meta
    name="author"
    content="Freimel Jerez"
  >

  <!-- Open Graph -->
  <meta property="og:title" content="FJ-IA">

  <meta
    property="og:description"
    content="Convierte una idea en texto, imagen, video o película."
  >

  <meta property="og:type" content="website">

  <meta
    property="og:url"
    content="https://demoflowapp.com/runtime/fj-ia"
  >

  <meta
    property="og:image"
    content="https://demoflowapp.com/runtime/fj-ia/images/logo-fj-ia.png"
  >

  <!-- Favicon -->
  <link
    rel="icon"
    type="image/png"
    href="<%= prefix %>/images/logo-fj-ia.png"
  >

  <!-- Bootstrap 5 -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Bootstrap Icons -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
    rel="stylesheet"
  >

  <!-- CSS principal -->
  <link
    rel="stylesheet"
    href="<%= prefix %>/styles/styles.css"
  >

</head>

<body>